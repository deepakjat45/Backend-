<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <h1>All chats </h1>
    <hr>
    <form method="get" action="/chats/new">
        <button>add new chat!</button>
    </form>
    <br>
    <br>
    <hr>
    <h3>See your chats below</h3>
    <hr>
    <br>
    <% for(chat of chats){ %>
    <div class="chat">
      <p>From: <b><%= chat.from %></b></p>
      <div class="msg">
        <p><%= chat.msg %></p>
        <form method="get" action="/chats/<%= chat._id %>/edit">
          <button class="edit">edit</button>
        </form>
      </div>
      <p>Received by <b><%= chat.to %></b>
        <p><%= chat.created_at.toString().split(" ")[4] %></p>
        <p><%= chat.created_at.toString().split(" ").slice(0, 4).join("-") %></p>
    </div>
    <hr>
    <% } %>
  </body>
</html>
